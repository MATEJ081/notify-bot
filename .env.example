# Copia questo file in .env, poi:
#   chmod 600 .env
# Non committare mai .env in git (vedi .gitignore).

# === TELEGRAM BOT (REQUIRED) ===
BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === GUARDRAILS (defaults are safe) ===
DRY_RUN=true
RATE_LIMIT_PER_MINUTE=5
DEDUP_WINDOW_SECONDS=300

# === MCP SERVER CONFIG ===
MCP_AUTH_TOKEN=your_secret_token_here
MCP_HOST=127.0.0.1
MCP_PORT=5000
