[Unit]
Description=Notify Bot MCP Server (Telegram)
Documentation=https://github.com/your-repo/notify-bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=_notify-bot
Group=_notify-bot
WorkingDirectory=/opt/notify-bot

# Environment: load from .env
EnvironmentFile=/opt/notify-bot/.env

# Python venv or system python
ExecStart=/opt/notify-bot/venv/bin/python3 mcp_server.py

# Restart on failure
Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/notify-bot/logs /opt/notify-bot/state

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=notify-bot

# Graceful shutdown
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
